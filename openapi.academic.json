{
  "openapi": "3.1.0",
  "info": {
    "title": "ElectroGPT Academic Action API",
    "description": "Action specialisee pour le cadrage academique.",
    "version": "2.4.2"
  },
  "servers": [
    {
      "url": "https://electrotechnique-gpt-tool.onrender.com",
      "description": "Public HTTPS endpoint for ChatGPT Actions"
    }
  ],
  "paths": {
    "/action-academic": {
      "get": {
        "summary": "Action Academique",
        "description": "Action ChatGPT specialisee pour cadrer un TFE, memoire ou besoin academique.",
        "operationId": "action_academic_action_academic_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 400
                },
                {
                  "type": "null"
                }
              ],
              "description": "Sujet ou besoin academique",
              "title": "Query"
            },
            "description": "Sujet ou besoin academique"
          },
          {
            "name": "input",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 400
                },
                {
                  "type": "null"
                }
              ],
              "description": "Alias principal",
              "title": "Input"
            },
            "description": "Alias principal"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcademicActionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcademicActionResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "query": {
            "type": "string",
            "title": "Query"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "next_step": {
            "type": "string",
            "title": "Next Step",
            "default": ""
          },
          "error": {
            "type": "string",
            "title": "Error",
            "default": ""
          },
          "academic_level": {
            "type": "string",
            "title": "Academic Level",
            "default": ""
          },
          "deliverable_type": {
            "type": "string",
            "title": "Deliverable Type",
            "default": ""
          },
          "domain_focus": {
            "type": "string",
            "title": "Domain Focus",
            "default": ""
          },
          "title_suggestions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Title Suggestions"
          },
          "problem_statement": {
            "type": "string",
            "title": "Problem Statement",
            "default": ""
          },
          "objectives": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Objectives"
          },
          "research_questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Research Questions"
          },
          "methodology_summary": {
            "type": "string",
            "title": "Methodology Summary",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "status",
          "source",
          "query",
          "answer"
        ],
        "title": "AcademicActionResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
