{
  "openapi": "3.1.0",
  "info": {
    "title": "ElectroGPT Realtime Action API",
    "description": "Action specialisee pour le dashboard temps reel et le streaming SSE.",
    "version": "2.4.2"
  },
  "servers": [
    {
      "url": "https://api.lbmdinanga-tech.com",
      "description": "Public HTTPS endpoint for ChatGPT Actions"
    }
  ],
  "paths": {
    "/action-realtime": {
      "get": {
        "summary": "Action Dashboard Temps Reel",
        "description": "Action ChatGPT specialisee pour obtenir un dashboard temps reel et un flux SSE externes.",
        "operationId": "action_realtime_action_realtime_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ],
              "description": "Demande de dashboard ou de streaming",
              "title": "Query"
            },
            "description": "Demande de dashboard ou de streaming"
          },
          {
            "name": "input",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ],
              "description": "Alias principal",
              "title": "Input"
            },
            "description": "Alias principal"
          },
          {
            "name": "pace_ms",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 2000,
              "minimum": 20,
              "description": "Cadence du flux SSE",
              "default": 120,
              "title": "Pace Ms"
            },
            "description": "Cadence du flux SSE"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RealtimeActionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
