            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RealtimeActionResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "query": {
            "type": "string",
            "title": "Query"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "next_step": {
            "type": "string",
            "title": "Next Step",
            "default": ""
          },
          "error": {
            "type": "string",
            "title": "Error",
            "default": ""
          },
          "dashboard_url": {
            "type": "string",
            "title": "Dashboard Url",
            "default": ""
          },
          "stream_url": {
            "type": "string",
            "title": "Stream Url",
            "default": ""
          },
          "recommended_signals": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Recommended Signals"
          },
          "pace_ms": {
            "type": "integer",
