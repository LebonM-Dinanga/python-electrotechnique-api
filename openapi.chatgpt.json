{
  "openapi": "3.1.0",
  "info": {
    "title": "Electrotechnique GPT Action API",
    "description": "Minimal OpenAPI schema expose uniquement l'endpoint /gpt-tool pour ChatGPT Actions, avec calcul, simulation, dashboard temps reel, visualisation, ingestion live capteurs/automates, diagnostic d'ingenierie, recherche technique et workflow academique.",
    "version": "2.4.2"
  },
  "paths": {
    "/gpt-tool": {
      "get": {
        "summary": "GPT Tool",
        "description": "Version minimale et stable pour les Actions ChatGPT. Meme schema JSON dans tous les cas.",
        "operationId": "gpt_tool_gpt_tool_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ],
              "description": "Question a traiter",
              "title": "Query"
            },
            "description": "Question a traiter"
          },
          {
            "name": "input",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ],
              "description": "Alias principal pour les Actions ChatGPT",
              "title": "Input"
            },
            "description": "Alias principal pour les Actions ChatGPT"
          },
          {
            "name": "max_results",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 1,
              "description": "Nombre maximum d'articles si mode arxiv",
              "default": 3,
              "title": "Max Results"
            },
            "description": "Nombre maximum d'articles si mode arxiv"
          },
          {
            "name": "auto_filter",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Ajoute automatiquement un filtre electrotechnique pour les recherches scientifiques.",
              "default": true,
              "title": "Auto Filter"
            },
            "description": "Ajoute automatiquement un filtre electrotechnique pour les recherches scientifiques."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GptToolResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
